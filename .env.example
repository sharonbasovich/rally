# Hosting-owner settings only. Never put these in a VITE_ variable.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=yolov8n-pose-640
ROBOFLOW_REGION=us
MAX_CAMERA_STREAMS=4
# Render supplies RENDER_EXTERNAL_URL automatically. Set PUBLIC_ORIGIN for a custom domain.
PUBLIC_ORIGIN=https://your-rally-service.onrender.com
